<Window x:Class="FamilyCreator.Revit.CreatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Creator" Width="620" Height="420"
        MinWidth="460" MinHeight="320" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7F9" FontFamily="Segoe UI">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="FAMILY CREATOR" FontSize="12" FontWeight="SemiBold" Foreground="#256C91"/>
            <TextBlock Text="Your family workspace" Margin="0,10,0,0" FontSize="26" FontWeight="SemiBold" Foreground="#182B38"/>
        </StackPanel>
        <Border Grid.Row="1" Margin="0,24,0,24" Padding="22" Background="White"
                BorderBrush="#DDE4E9" BorderThickness="1" CornerRadius="8">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Ready to get started" FontSize="18" FontWeight="SemiBold" Foreground="#182B38"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" Foreground="#556673"
                           Text="Family Creator is connected to Revit. Product inputs, ChatGPT sign-in and family creation will be added in the next steps."/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="2">
            <TextBlock Text="Revit 2027 · Family Creator" VerticalAlignment="Center" Foreground="#647582"/>
            <Button Content="Close" HorizontalAlignment="Right" Padding="20,7" IsCancel="True" Click="Close_Click"/>
        </Grid>
    </Grid>
</Window>
