<Window x:Class="FamilyCreator.Revit.ModelPickerDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Choose a model" Width="540" Height="660" MinWidth="420" MinHeight="500" WindowStartupLocation="CenterOwner" Background="#F7FAFF" Foreground="#002340" FontFamily="Poppins, Arial" FontSize="14">
 <Window.Resources>
  <Style x:Key="ModelChoice" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Padding" Value="14"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="White" BorderBrush="#D8E4F3" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentPresenter/>
      <Border x:Name="CheckRing" Grid.Column="1" Width="24" Height="24" CornerRadius="12" BorderBrush="#CBD5E1" BorderThickness="1" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Check" Text="✓" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="#F0F6FB"/><Setter TargetName="Card" Property="BorderBrush" Value="#8EAEC6"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="#EAF2F8"/><Setter TargetName="Card" Property="BorderBrush" Value="#226B95"/><Setter TargetName="CheckRing" Property="Background" Value="#002340"/><Setter TargetName="CheckRing" Property="BorderBrush" Value="#002340"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#1769E0"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Background="#F7FAFF">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#002340" Padding="24,22"><StackPanel>
   <TextBlock Text="YOUR WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#A9C8DF"/>
   <TextBlock Text="Choose your model" FontSize="25" FontWeight="SemiBold" Foreground="White" Margin="0,5,0,0"/>
   <TextBlock Text="Select the model for your next conversation request." FontSize="12" Foreground="#D6E4EF" TextWrapping="Wrap" Margin="0,7,0,0"/>
  </StackPanel></Border>
  <StackPanel Grid.Row="1" Margin="24,18,24,10">
   <Border Background="White" BorderBrush="#C8D7E4" BorderThickness="1" CornerRadius="10" Padding="12,11">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock Text="⌕" FontSize="20" Foreground="#60788B" Margin="0,0,10,0" VerticalAlignment="Center"/>
     <Grid Grid.Column="1"><TextBox x:Name="ModelSearch" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="Search_Changed" AutomationProperties.Name="Search models"/><TextBlock x:Name="SearchPlaceholder" Text="Search models…" Foreground="#6B7280" IsHitTestVisible="False" VerticalAlignment="Center"/></Grid>
    </Grid>
   </Border>
   <TextBlock x:Name="CatalogNotice" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Foreground="#92400E" Margin="0,10,0,0"/>
   <TextBlock x:Name="ModelCount" FontSize="11" Foreground="#607080" Margin="2,12,0,0"/>
  </StackPanel>
  <Grid Grid.Row="2" Margin="24,0,24,4">
   <ListBox x:Name="ModelList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ModelChoice}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Model_Changed" MouseDoubleClick="Model_DoubleClick" PreviewKeyDown="Model_KeyDown" AutomationProperties.Name="Available models">
    <ListBox.ItemTemplate><DataTemplate><StackPanel>
     <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="IN USE" FontSize="9" FontWeight="SemiBold" Foreground="#226B95" Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
     <TextBlock Text="{Binding Id}" Foreground="#667789" FontSize="11" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
    </StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <TextBlock x:Name="EmptyModels" Text="No matching models. Try a different search." Visibility="Collapsed" Foreground="#667789" TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="20"/>
  </Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#D8E4F3" BorderThickness="0,1,0,0" Padding="24,16"><StackPanel>
   <Expander Header="Enter a model ID manually" FontSize="11" Foreground="#667789"><TextBox x:Name="ManualModel" Padding="10" Margin="0,10,0,4" MaxLength="150" TextChanged="Manual_Changed" AutomationProperties.Name="Manual API model ID"/></Expander>
   <TextBlock Text="Model access and file support vary. API usage is billed to your OpenAI project." FontSize="11" Foreground="#667789" TextWrapping="Wrap" Margin="0,10,0,14"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="SELECTED MODEL" FontSize="9" Foreground="#667789"/><TextBlock x:Name="SelectionSummary" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel>
    <Button x:Name="UseModelButton" Grid.Column="1" Content="Use model" Padding="20,10" Click="UseModel_Click" IsEnabled="False"/>
   </Grid>
  </StackPanel></Border>
 </Grid>
</Window>
